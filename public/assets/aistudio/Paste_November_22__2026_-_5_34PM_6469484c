.i{width:1em;height:1em;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}
#app{height:100%;display:grid;grid-template-columns:264px 1fr;gap:10px;padding:10px 10px 104px}
#side{background:var(--s1);border-radius:var(--r);padding:18px 10px 12px;display:flex;flex-direction:column;gap:2px;overflow:auto;scrollbar-width:thin}
.logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:20px;padding:0 12px 16px}
