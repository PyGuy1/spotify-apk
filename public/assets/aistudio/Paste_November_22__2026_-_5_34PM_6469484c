.nav{gap:14px;justify-content:flex-start;width:100%;padding:10px 12px;border-radius:10px;color:var(--mu);font-weight:600;font-size:15px;text-align:left}
.nav .i{font-size:21px}.nav:hover{color:var(--tx);background:var(--s2)}.nav.on{color:#fff;background:var(--s3)}
.shd{display:flex;justify-content:space-between;align-items:center;color:var(--mu);font-weight:600;font-size:12px;letter-spacing:.06em;text-transform:uppercase;padding:18px 12px 6px}
.shd button{color:var(--mu);font-size:18px;width:28px;height:28px;border-radius:8px}.shd button:hover{color:#fff;background:var(--s2)}
.pln{padding:6px 8px;gap:12px}.pln .mc{width:40px;height:40px;flex-shrink:0}.pln .pn{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:inherit}
main{background:var(--s1);border-radius:var(--r);overflow:auto;padding:26px 30px 40px;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.2) transparent;overscroll-behavior:contain}
main>*{animation:fadein .24s ease both}@keyframes fadein{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
img{transition:opacity .22s ease,transform .3s ease}button,.card,.song,.tile{transition:transform .18s ease,opacity .18s ease,background .18s ease}button:active,.card:active,.song:active,.tile:active{transform:scale(.985)}
h1{font-size:30px;font-weight:700;letter-spacing:-.5px;overflow-wrap:anywhere}
h2{font-size:19px;font-weight:700;margin:30px 0 12px;display:flex;align-items:center;gap:10px}
h2 .ib{width:30px;height:30px;background:var(--s2);font-size:17px}h2 .ib:hover{background:var(--s3)}
h2 .chip{font-size:12px;padding:4px 10px;margin-left:4px}
.cbtn{gap:6px;background:var(--s2);border:1px solid var(--line);border-radius:10px;padding:4px 10px 4px 12px;font-size:16px;font-weight:600}.cbtn:hover{background:var(--s3)}.cbtn .i{font-size:16px;color:var(--mu)}
.sub{color:var(--mu);margin:6px 0 14px}.empty{color:var(--mu);padding:14px 0}.empty .chip{margin-left:8px}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}
.chip{gap:8px;background:var(--s2);border:1px solid var(--line);padding:8px 16px;border-radius:999px;font-weight:600}
.chip:hover{background:var(--s3)}.chip.pri{background:var(--ac);border-color:var(--ac);color:#fff}.chip.pri:hover{filter:brightness(1.08)}
.chip.danger{background:transparent;border-color:rgba(255,120,130,.5);color:#ff9aa3}.chip.danger:hover{background:rgba(255,120,130,.12)}
.search{display:flex;align-items:center;gap:12px;background:var(--s2);border:1px solid var(--line);border-radius:999px;padding:0 18px;max-width:600px;margin-bottom:20px}
.search .i{font-size:19px;color:var(--mu)}.search input{flex:1;background:none;border:0;color:var(--tx);padding:13px 0;font:inherit;font-size:15px;outline:0}.search input::placeholder{color:#7a85a8}
.shelf{display:flex;gap:12px;overflow-x:auto;padding:2px 2px 12px;margin:0 -2px;scrollbar-width:none}
.card{flex:0 0 150px;width:150px;padding:10px;border-radius:12px;cursor:pointer;position:relative;-webkit-touch-callout:none;-webkit-user-select:none;user-select:none;transition:background .15s}
.card:hover{background:var(--s2)}
.cw{position:relative;margin-bottom:10px}
.card img,.av{width:130px;height:130px;border-radius:8px;object-fit:cover;display:block;background:var(--s3)}
.card.ar img,.card.ar .av{border-radius:50%}
.av{display:grid;place-items:center;font-weight:700;font-size:30px;color:#fff;background:hsl(var(--h) 35% 34%);overflow:hidden}.av img{width:100%;height:100%;margin:0;border-radius:inherit}
.pb{position:absolute;right:6px;bottom:6px;width:38px;height:38px;border-radius:50%;background:var(--ac);color:#fff;font-size:17px;opacity:0;transition:opacity .15s;box-shadow:0 4px 12px rgba(0,0,0,.4)}
