.mc{display:block}.mc .cov{border-radius:5px;font-size:16px}
.lib .card{width:auto;flex:none}.lib .card .cov{margin-bottom:10px}
.pln .cov.g4{border-radius:5px}
/* rows */
.row{display:grid;grid-template-columns:52px 1fr auto 40px 40px;gap:12px;align-items:center;padding:7px 10px;border-radius:10px;cursor:pointer;-webkit-touch-callout:none;-webkit-user-select:none;user-select:none;transition:background .15s}
.row:hover{background:var(--s2)}
.row img{width:52px;height:52px;border-radius:6px;object-fit:cover;background:var(--s3)}
.row.rm{grid-template-columns:52px 1fr auto 40px 40px 40px}
.row.now{background:var(--ac-t)}.row.now .t{color:#a9c3ff}
.mt{min-width:0}.d{color:var(--mu);font-size:13px;font-variant-numeric:tabular-nums}
.ib{width:40px;height:40px;border-radius:50%;color:var(--mu);font-size:20px}.ib:hover{color:#fff;background:var(--s2)}.ib.on{color:#8fb1ff}
.hero{display:flex;gap:20px;align-items:flex-end;margin-bottom:6px}.hero .av{width:140px;height:140px;border-radius:50%;font-size:44px}
.hero .hcov{width:180px;flex-shrink:0}.hero .hcov .cov{border-radius:8px;font-size:60px;box-shadow:0 8px 24px rgba(0,0,0,.4)}.hmeta{min-width:0}
.eq{display:inline-flex;gap:2px;align-items:flex-end;height:12px;margin-right:7px;vertical-align:-1px}.eq i{width:3px;background:var(--ac);animation:eq .9s infinite ease-in-out}.eq i:nth-child(2){animation-delay:.2s}.eq i:nth-child(3){animation-delay:.4s}@keyframes eq{0%,100%{height:3px}50%{height:12px}}
body.paused .eq i{animation-play-state:paused}
.spin{animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
.sk{pointer-events:none}.skimg,.skl{background:var(--s3);border-radius:8px;animation:pulse 1.4s ease-in-out infinite}.skimg{width:130px;height:130px;margin-bottom:10px}.skl{height:11px;width:80%;margin:7px 0}@keyframes pulse{50%{opacity:.5}}
.tabs{display:flex;gap:8px;overflow-x:auto;margin:0 0 14px;scrollbar-width:none}.tabs .chip{white-space:nowrap}.tabs .chip.on{background:#fff;color:#0a0e1e;border-color:#fff}
.gridc{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:6px}.gridc .card{width:auto;flex:none}
.sug{max-width:600px;margin:-10px 0 10px}.sug button{display:flex;gap:12px;width:100%;justify-content:flex-start;padding:10px 14px;border-radius:10px;color:var(--mu)}.sug button:hover{background:var(--s2);color:#fff}
.rrow{display:flex;align-items:center;gap:12px;padding:4px 8px;border-radius:10px;cursor:pointer}.rrow:hover{background:var(--s2)}.rrow>.i{color:var(--mu);font-size:18px}.rrow span{flex:1}
.pill{align-self:center;padding:6px 14px;border-radius:999px;background:var(--s2);border:1px solid var(--line);font-size:12px;font-weight:600;color:var(--mu)}.pill.on{color:#8fe0b8}
/* dock */
