function normLyr(r){
  const sy=parseLRC(r.syncedLyrics),pl=(r.plainLyrics||'').split(/\r?\n/).map(x=>x.trim());
  return{title:r.trackName,artist:r.artistName,instrumental:!!r.instrumental&&!sy&&!(r.plainLyrics),synced:!!sy,lines:sy||pl.map(text=>({t:null,text}))};
}
function bestLyr(arr,t,title){
  if(!Array.isArray(arr))return null;
  const arts=cleanArtist(t.artist).toLowerCase().split(/[\s,&]+/).filter(x=>x.length>2);let best=null;
  arr.forEach(r=>{if(!(r.plainLyrics||r.syncedLyrics))return;const ts=jac(r.trackName||'',title);if(ts<.45)return;
    const dd=t.duration&&r.duration?Math.abs(t.duration-r.duration):99,ca=(r.artistName||'').toLowerCase();
    const sc=ts*2+(dd<=3?1:dd<=10?.5:0)+(r.syncedLyrics?.2:0)+(arts.some(a=>ca.includes(a))?.5:0);if(!best||sc>best.sc)best={sc,r}});
  return best&&best.r;
}
function getLyrics(t){
  if(lyrCache[t.id])return lyrCache[t.id];
  const p=(async()=>{
    const title=cleanTitle(t.title),artist=cleanArtist(t.artist),dur=Math.round(t.duration||0),B='https://lrclib.net/api/';
    const q=o=>Object.entries(o).filter(([,v])=>v).map(([k,v])=>k+'='+encodeURIComponent(v)).join('&');
    let res=null;
    try{res=await getJSON(B+'get?'+q({track_name:title,artist_name:artist,duration:dur||''}))}catch{}
    if(!res||!(res.plainLyrics||res.syncedLyrics||res.instrumental)){
      res=null;for(const o of [{track_name:title,artist_name:artist},{q:(title+' '+artist).trim()},{q:title}]){
        try{const b=bestLyr(await getJSON(B+'search?'+q(o)),t,title);if(b){res=b;break}}catch{}}
    }
    return res?normLyr(res):null;
  })().then(r=>{if(!r)delete lyrCache[t.id];return r}).catch(()=>{delete lyrCache[t.id];return null});
  return lyrCache[t.id]=p;
}
/* Google's free endpoint for scripts the built-in tables can't do (Chinese, Thai, Arabic, ...) and for translation */
async function gTrans(text,kind){
  const key=kind+'|'+text;if(key in gCache)return gCache[key];
  const u='https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=en&dt=t&dt=rm&q='+encodeURIComponent(text);
  let d=null;try{d=await getJSON(u)}catch{try{d=JSON.parse(await fetchText(u,t=>t.trim()[0]==='['))}catch{}}
  let r=null;
  if(d&&Array.isArray(d[0])){
    if(kind==='rm'){const seg=d[0].find(x=>x&&x[0]==null&&typeof x[3]==='string'&&x[3]);r=seg?seg[3]:null}
    else r=d[0].map(x=>(x&&x[0])||'').join('').trim()||null;
  }
  return gCache[key]=r;
}
const cap1=s=>s?s.charAt(0).toUpperCase()+s.slice(1):s;
async function romanizeLines(lines,onProg){
  const out=lines.map(l=>{if(!l)return{text:'',need:false};const r=romanOffline(l);return{text:r.text,need:r.unsup}});
  const need=out.map((o,i)=>o.need?i:-1).filter(i=>i>=0);let done=0;
  if(need.length)await pool(need.map(i=>async()=>{const g=await gTrans(lines[i],'rm');out[i].text=g||romanOffline(lines[i],true).text;onProg&&onProg(++done,need.length)}),5);
  return out.map(o=>cap1(o.text));
}
async function translateLines(lines,onProg){
  const out=lines.map(()=>'');let done=0,any=false;
  await pool(lines.map((l,i)=>async()=>{if(!l){return}const g=await gTrans(l,'t');if(g){out[i]=g;any=true}onProg&&onProg(++done,lines.length)}),6);
  return any?out:null;
}
/* ---- UI ---- */
const lyrLines=()=>{const m=lyr.mode;return m==='rom'&&lyr.rom?lyr.rom:m==='en'&&lyr.en?lyr.en:null};
function renderLyrics(){
  const body=$('#lyrbody');if(!body)return;
  $$('#lyrseg [data-lm]').forEach(b=>b.classList.toggle('on',b.dataset.lm===lyr.mode));
  const d=lyr.data;let html='';
  if(lyr.loading)html='<div class="lmsg">Finding lyrics…</div>';
  else if(!d)html='<div class="lmsg">No lyrics found for this song.<br><button class="chip" id="lyrwrong2">Search again</button></div>';
  else if(d.instrumental)html='<div class="lmsg">Instrumental</div>';
  else{
    const alt=lyrLines(),all=d.lines.map(l=>l.text).join(' ');
    if(lyr.mode==='rom'&&!hasNonLatin(all))html+='<div class="lnote">These lyrics are already in English letters.</div>';
    if(lyr.busy)html+=`<div class="lnote">${esc(lyr.busy)}</div>`;
    if(lyr.mode==='en'&&!lyr.busy&&!alt)html+='<div class="lnote">Translation isn’t available right now. Showing the original.</div>';
    if(lyr.mode==='rom'&&!lyr.busy&&hasNonLatin(all)&&!alt)html+='<div class="lnote">Couldn’t romanize these lyrics. Showing the original.</div>';
    html+=d.lines.map((l,i)=>{const tx=alt?alt[i]:l.text;return tx?`<p class="ll${d.synced?'':' plain'}"${l.t!=null?` data-t="${l.t}"`:''}>${esc(tx)}</p>`:'<p class="ll gap"></p>'}).join('');
  }
  body.innerHTML=html;lyr.active=-1;
  $('#lyrsrc').textContent=d&&!d.instrumental?`Lyrics from LRCLIB${d.synced?' · synced':''}`:'';
  $('#lyrwrong').hidden=!queue[idx];
  if(d&&d.synced)updateLyrActive(eCur(),true);
}
function updateLyrActive(c,force){
  const L=lyr.data&&lyr.data.lines;if(!L||!L.length||L[0].t==null)return;
  let lo=0,hi=L.length-1,k=-1;while(lo<=hi){const m=(lo+hi)>>1;if(L[m].t<=c+.2){k=m;lo=m+1}else hi=m-1}
  if(k===lyr.active&&!force)return;lyr.active=k;
  const els=$$('#lyrbody .ll');els.forEach((e,i)=>{e.classList.toggle('on',i===k);e.classList.toggle('past',i<k)});
  const el=els[k],bd=$('#lyrbody');if(el&&!lyr.userScroll)bd.scrollTo({top:Math.max(0,el.offsetTop-bd.clientHeight/2+el.offsetHeight/2),behavior:force?'auto':'smooth'});
}
async function showLyrics(){
  const t=queue[idx];if(!t)return;
  if(lyr.id!==t.id){lyr={id:t.id,mode:lyr.mode,data:null,lines:[],rom:null,en:null,active:-1,busy:'',userScroll:false,loading:true};renderLyrics();
    const my=t.id,d=await getLyrics(t);if(lyr.id!==my)return;lyr.data=d;lyr.loading=false;renderLyrics()}
  else renderLyrics();
  if(lyr.mode!=='orig')applyMode(lyr.mode);
}
async function applyMode(m){
  lyr.mode=m;PS.lm=m;savePS();
  const d=lyr.data;renderLyrics();if(!d||d.instrumental||m==='orig')return;
  const my=lyr.id,texts=d.lines.map(l=>l.text);
  if(m==='rom'&&!lyr.rom&&hasNonLatin(texts.join(' '))){lyr.busy='Converting to English letters…';renderLyrics();const r=await romanizeLines(texts);if(lyr.id!==my)return;lyr.rom=r;lyr.busy=''}
  if(m==='en'&&!lyr.en){lyr.busy='Translating…';renderLyrics();const r=await translateLines(texts,(a,b)=>{if(lyr.id===my&&lyr.busy)lyr.busy=`Translating… ${a}/${b}`});if(lyr.id!==my)return;lyr.en=r;lyr.busy=''}
  if(lyr.mode===m)renderLyrics();
}
function toggleLyrics(on){
  lyrOn=on===undefined?!lyrOn:!!on;
  $('#fs').classList.toggle('lyr-on',lyrOn);$$('#lyrb,#lyrdock').forEach(b=>b.classList.toggle('on',lyrOn));
  if(lyrOn)showLyrics();
}
async function lyrWrong(){
  const t=queue[idx];if(!t)return;
  const q=await askText('Find lyrics',(cleanTitle(t.title)+' '+cleanArtist(t.artist)).trim(),{placeholder:'Song name and artist',ok:'Search'});if(!q)return;
  let arr=[];try{arr=await getJSON('https://lrclib.net/api/search?q='+encodeURIComponent(q))}catch{}
  arr=(arr||[]).filter(x=>x.plainLyrics||x.syncedLyrics).slice(0,12);
  if(!arr.length){toast('No lyrics found for that search');return}
  sheet._lp=arr;sheet._lt=t.id;
  openSheet('Choose lyrics',arr.map((x,i)=>`<button class="act" data-lp="${i}"><span style="flex:1;min-width:0"><div class="t">${esc(x.trackName)}</div><div class="a">${esc(x.artistName)} · ${fmt(x.duration)}${x.syncedLyrics?' · Synced':''}</div></span></button>`).join(''),'lyrpick');
}
function lyrPickClick(e){
  const b=e.target.closest('[data-lp]');if(!b)return;const r=sheet._lp[+b.dataset.lp],id=sheet._lt;
  lyrCache[id]=Promise.resolve(normLyr(r));closeSheet();
  if(queue[idx]&&queue[idx].id===id){lyr.id=null;showLyrics()}
}
$('#lyrb').onclick=()=>toggleLyrics();
$('#lyrdock').onclick=()=>{openFS();toggleLyrics(true)};
$('#lyrseg').addEventListener('click',e=>{const b=e.target.closest('[data-lm]');if(b)applyMode(b.dataset.lm)});
$('#lyrwrong').onclick=lyrWrong;
$('#lyrbody').addEventListener('click',e=>{const p=e.target.closest('.ll[data-t]');if(p)eSeek(+p.dataset.t);if(e.target.closest('#lyrwrong2'))lyrWrong()});
['wheel','touchstart'].forEach(ev=>$('#lyrbody').addEventListener(ev,()=>{lyr.userScroll=true;clearTimeout(lyr._ut);lyr._ut=setTimeout(()=>lyr.userScroll=false,3500)},{passive:true}));

/* ================= back / forward (in-app buttons + the phone's back button) ================= */
const nav={stack:[{v:'home',t:'',b:''}],pos:0};let ovDepth=0,ignorePop=0;const popQueue=[];
try{history.replaceState({n:0},'')}catch{}
function go(v,title,by,fromNav){
  const cur=nav.stack[nav.pos];
  if(!fromNav&&!(cur&&cur.v===v&&(cur.t||'')===(title||''))){
    const push=()=>{nav.stack=nav.stack.slice(0,nav.pos+1);nav.stack.push({v,t:title||'',b:by||''});nav.pos=nav.stack.length-1;try{history.pushState({n:nav.pos},'')}catch{}topbar()};
    if(ignorePop>0)popQueue.push(push);else push();
  }
  view=v;viewTitle=title||'';viewBy=by||'';render();$('#main').scrollTop=0;
}
const overlayOpen=()=>!$('#dlg').hidden||!$('#sheet').hidden||!$('#fs').hidden;
function syncOv(){   // an open player / sheet / dialog takes one history entry, so "back" closes it
  const open=overlayOpen();
  if(open&&!ovDepth){try{history.pushState({n:nav.pos,ov:1},'');ovDepth=1}catch{}}
  else if(!open&&ovDepth){ovDepth=0;ignorePop++;try{history.back()}catch{ignorePop--}}
}
function closeTop(){if(!$('#dlg').hidden){$('#dc').click();return}if(!$('#sheet').hidden){closeSheet();return}if(!$('#fs').hidden)closeFS()}
addEventListener('popstate',e=>{
  if(ignorePop>0){ignorePop--;if(ignorePop===0)popQueue.splice(0).forEach(f=>f());return}
  if(ovDepth&&overlayOpen()){ovDepth=0;closeTop();if(overlayOpen()){try{history.pushState({n:nav.pos,ov:1},'');ovDepth=1}catch{}}return}
  const n=e.state&&typeof e.state.n==='number'?e.state.n:0;
  if(n===nav.pos)return;
  nav.pos=Math.max(0,Math.min(nav.stack.length-1,n));const s=nav.stack[nav.pos];go(s.v,s.t,s.b,true);
});
const VT={home:'Home',search:'Search',library:'Your Library',settings:'Settings',liked:'Liked Songs',recent:'Recently played'};
function topbar(){
  const m=$('#main');if(!m)return;let b=m.querySelector('.tbar');
  if(!b){m.insertAdjacentHTML('afterbegin',`<div class="tbar"><span class="tt"></span></div>`);b=m.querySelector('.tbar')}
  b.querySelector('.tt').textContent=VT[view]||(view.startsWith('pl:')?view.slice(3):viewTitle||'');
  b.classList.toggle('min',mobile()&&nav.pos<=0&&nav.pos>=nav.stack.length-1);
  b.classList.toggle('scrolled',m.scrollTop>10);
}
$('#main').addEventListener('scroll',()=>{const b=$('#main .tbar');if(b)b.classList.toggle('scrolled',$('#main').scrollTop>10)},{passive:true});
document.addEventListener('keydown',e=>{if(e.key==='/'&&!['INPUT','TEXTAREA'].includes(e.target.tagName)&&$('#dlg').hidden&&$('#sheet').hidden){e.preventDefault();go('search')}});

const SS=store.get('sess',null);
if(SS&&SS.q&&SS.q.length){queue=SS.q;idx=Math.min(Math.max(SS.i||0,0),queue.length-1);radioMode=!!SS.rm;resumeAt=SS.t||0;restored=true;paintNow(queue[idx]);updNav()}
updNav();applyPS();
render();
discover();
</script>
