.seek{display:flex;gap:10px;align-items:center;width:100%;color:var(--mu);font-size:12px;font-variant-numeric:tabular-nums}
input[type=range]{--p:0%;flex:1;height:18px;background:transparent;-webkit-appearance:none;appearance:none;cursor:pointer;outline:none}
input[type=range]::-webkit-slider-runnable-track{height:4px;border-radius:4px;background:linear-gradient(var(--ac),var(--ac)) 0/var(--p) 100% no-repeat,rgba(255,255,255,.2)}
input[type=range]::-moz-range-track{height:4px;border-radius:4px;background:rgba(255,255,255,.2)}input[type=range]::-moz-range-progress{height:4px;border-radius:4px;background:var(--ac)}
