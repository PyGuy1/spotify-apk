@media(hover:hover){.cmore{opacity:0}.card:hover .cmore{opacity:1}}
.t{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.a{color:var(--mu);font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(148px,1fr));gap:10px}
.tile{padding:14px;border-radius:10px;font-weight:700;font-size:16px;min-height:78px;color:#fff;align-items:flex-start;justify-content:flex-start;transition:filter .15s}.tile:hover{filter:brightness(1.15)}
/* covers (playlists) */
.cov{position:relative;width:100%;aspect-ratio:1;border-radius:8px;overflow:hidden;background:var(--s3);display:grid;place-items:center;color:var(--mu);font-size:34px}
.cov img{width:100%;height:100%;object-fit:cover;display:block;border-radius:0}.cov.g4{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr}
