  download('Pulse backup.json',JSON.stringify({app:'Pulse',version:2,exported:new Date().toISOString(),liked:liked.map(sl),playlists:Object.fromEntries(Object.entries(playlists).map(([k,v])=>[k,v.map(sl)])),covers:store.get('plmeta',{})}),'application/json');
  toast('Backup saved');
