.fsmain{width:min(540px,100%);flex:1;display:flex;flex-direction:column;justify-content:center;gap:18px;min-height:0}.fsmain>*{width:100%}
#fsbox{position:relative;width:min(84vw,46vh,460px);aspect-ratio:1;margin:0 auto;border-radius:12px;overflow:hidden;background:#0a0f26;flex-shrink:0;box-shadow:0 20px 50px rgba(0,0,0,.5)}
