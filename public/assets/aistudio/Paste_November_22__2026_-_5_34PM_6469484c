#fs .btns{justify-content:space-between}#fs .btns button{font-size:24px;width:52px;height:52px}#fs .btns .play{width:68px;height:68px;font-size:28px}
.fsx{display:flex;justify-content:space-around;padding:4px;border-radius:14px;background:rgba(255,255,255,.07)}
.fsx .ib{width:auto;font-size:12px;font-weight:600;padding:0 12px;height:48px;border-radius:10px;flex-direction:column;gap:2px}.fsx .ib .i{font-size:19px}
#ytwrap{position:fixed;left:-400px;top:0;width:240px;height:135px;z-index:60;border-radius:12px;overflow:hidden;background:#000}#ytwrap iframe{width:100%;height:100%;border:0}
