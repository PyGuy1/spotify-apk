<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#060a18">
<title>Pulse</title>
<style>
:root{--bg:#0a0e1e;--s1:#10162c;--s2:#171e3a;--s3:#212a4d;--line:rgba(255,255,255,.09);--tx:#eef1fb;--mu:#98a2c3;--ac:#5b8def;--ac-t:rgba(91,141,239,.18);--r:14px;--safe:env(safe-area-inset-bottom,0px);--top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box;margin:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
