async function restoreBackup(j){
  const pls=j.playlists||{},names=Object.keys(pls).filter(n=>n!==LIKED),ln=(j.liked||[]).length+((pls[LIKED]||[]).length);
  if(!(await askConfirm('Restore backup',`${names.length} playlist${names.length===1?'':'s'} and ${ln} liked song${ln===1?'':'s'} will be added. Songs you already have are not duplicated.`,'Restore')))return;
  let n=0;
  names.forEach(k=>{const ex=playlists[k]||[],ids=new Set(ex.map(t=>t.id)),add=(pls[k]||[]).filter(t=>t&&t.id&&!ids.has(t.id));playlists[k]=ex.concat(add);n+=add.length});
  const lid=new Set(liked.map(t=>t.id)),la=[...(j.liked||[]),...(pls[LIKED]||[])].filter(t=>t&&t.id&&!lid.has(t.id));liked=liked.concat(la);n+=la.length;
  const meta=store.get('plmeta',{});Object.entries(j.covers||{}).forEach(([k,v])=>{if(!meta[k]&&playlists[k])meta[k]=v});store.set('plmeta',meta);
  store.set('playlists',playlists);store.set('liked',liked);render();toast(`Restored ${n} songs`);
}

