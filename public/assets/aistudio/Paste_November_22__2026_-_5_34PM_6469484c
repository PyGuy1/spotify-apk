function coverHTML(n,ov){
  if(n===LIKED)return `<div class="cov liked">${ic('heart-fill')}</div>`;
  const tr=playlists[n]||[],m=store.get('plmeta',{})[n],c=ov!==undefined?ov:(m&&m.cover);
  if(c)return `<div class="cov"><img src="${esc(c)}" alt=""></div>`;
  if(tr.length>=4){const pick=[],seen=new Set();tr.forEach(t=>{if(pick.length<4&&!seen.has(t.thumb)){seen.add(t.thumb);pick.push(t)}});tr.forEach(t=>{if(pick.length<4&&!pick.includes(t))pick.push(t)});
    return `<div class="cov g4">${pick.map(t=>`<img src="${esc(cov(t,160))}" data-fb="${esc(fbs(t,160))}" alt="">`).join('')}</div>`}
  if(tr.length)return `<div class="cov"><img src="${esc(cov(tr[0],240))}" data-fb="${esc(fbs(tr[0],240))}" alt=""></div>`;
  return `<div class="cov">${ic('note')}</div>`;
}
function renderSide(){
  $('#pls').innerHTML=[LIKED,...Object.keys(playlists)].map(n=>{const v=n===LIKED?'liked':'pl:'+n;return `<button class="nav pln" data-view="${esc(v)}"><span class="mc">${coverHTML(n)}</span><span class="pn">${esc(n)}</span></button>`}).join('');
