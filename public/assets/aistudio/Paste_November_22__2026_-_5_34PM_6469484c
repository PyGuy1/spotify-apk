<script>
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const store={get:(k,d)=>{try{const v=JSON.parse(localStorage.getItem(k));return v??d}catch{return d}},set:(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch{}}};
const ic=n=>`<svg class="i"><use href="#i-${n}"/></svg>`;
const esc=s=>(s||'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const fmt=s=>{if(s==null||!isFinite(s))return'';s=Math.round(s);return Math.floor(s/60)+':'+String(s%60).padStart(2,'0')};
const cache={},cached=(k,f,ttl=9e5)=>{const e=cache[k];if(e&&Date.now()-e.t<ttl)return e.p;const p=Promise.resolve().then(f);cache[k]={t:Date.now(),p};p.catch(()=>delete cache[k]);return p};
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
let liked=store.get('liked',[]),playlists=store.get('playlists',{}),hist=store.get('hist',[]),autoplay=store.get('auto',true);
let view='home',viewTitle='',list=[],queue=[],idx=-1,shuffle=false,shufSnap=null,repeat=false,results=[],lastQ='',radioMode=false,wantPlay=false,homeT=Date.now(),sheetKind='',restored=false,resumeAt=0,pendingSeek=0;
const isLiked=id=>liked.some(t=>t.id===id);
function toast(m){const t=$('#toast');t.textContent=m;t.style.display='block';clearTimeout(t._h);t._h=setTimeout(()=>t.style.display='none',2400)}
const mobile=()=>innerWidth<=760;
/* ---------- player slider settings + custom slider ---------- */
const PS=Object.assign({sty:'round',col:'cover',hnd:'dot',thumb:false,tip:true,remain:false,wanim:true,skip:10,fscol:true,lm:'orig',lsz:'m'},store.get('ps',{}));
const SLS=['thin','round','bold','wavy','wave','dots','material','ios'];
const savePS=()=>store.set('ps',PS);
function applyPS(){
  const b=document.body;b.dataset.slc=PS.col;b.dataset.hnd=PS.hnd;b.dataset.lsz=PS.lsz;
  b.classList.toggle('sl-thumb',!!PS.thumb);b.classList.toggle('sl-notip',!PS.tip);b.classList.toggle('no-wave-anim',PS.wanim===false);
  ['#seek','#fseek','#vol','#slprev'].forEach(q=>{const el=$(q);if(!el)return;SLS.forEach(x=>el.classList.remove('s-'+x));let st=PS.sty;if(el.id==='vol'&&(st==='wave'||st==='dots'))st='round';el.classList.add('s-'+st)});
}
function makeSlider(el,o){
  const max=o.max||1000;let v=o.value||0,drag=false;
  const paint=()=>{el.style.setProperty('--p',(v/max*100)+'%');el.setAttribute('aria-valuenow',Math.round(v))};
  Object.defineProperty(el,'value',{get:()=>v,set:x=>{v=Math.max(0,Math.min(max,+x||0));paint()},configurable:true});
  const frac=e=>{const r=el.getBoundingClientRect();return Math.max(0,Math.min(1,(e.clientX-r.left)/(r.width||1)))};
  const tipAt=f=>{const t=el.querySelector('.tip');if(!t||!o.tip)return;t.textContent=o.tip(f);const w=el.getBoundingClientRect().width||1;t.style.left=Math.max(26,Math.min(w-26,f*w))+'px'};
  const fire=n=>el.dispatchEvent(new Event(n,{bubbles:true}));
  el.addEventListener('pointerdown',e=>{if(e.button>0)return;drag=true;try{el.setPointerCapture(e.pointerId)}catch{}el.classList.add('drag');const f=frac(e);v=f*max;paint();tipAt(f);fire('input')});
  el.addEventListener('pointermove',e=>{const f=frac(e);tipAt(f);if(drag){v=f*max;paint();fire('input')}});
  const end=()=>{if(!drag)return;drag=false;el.classList.remove('drag');fire('change')};
  el.addEventListener('pointerup',end);el.addEventListener('pointercancel',end);
  el.addEventListener('keydown',e=>{const k=e.key;if(!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown','Home','End'].includes(k))return;e.preventDefault();
    const st=o.keyStep?o.keyStep():max/20;if(k==='Home')v=0;else if(k==='End')v=max;else v+=(k==='ArrowLeft'||k==='ArrowDown')?-st:st;
    v=Math.max(0,Math.min(max,v));paint();fire('input');fire('change')});
  paint();return el;
}
makeSlider($('#vol'),{max:100,value:store.get('vol',80),tip:f=>Math.round(f*100)+'%'});
$('#vol').addEventListener('change',()=>store.set('vol',$('#vol').value));
const seekOpts={max:1000,tip:f=>{const d=eDur();return d?fmt(f*d):'0:00'},keyStep:()=>{const d=eDur();return d?PS.skip/d*1000:50}};
makeSlider($('#seek'),seekOpts);makeSlider($('#fseek'),seekOpts);
applyPS();

/* ---------- full-screen colours + 360° halo, scanned from the whole cover ---------- */
const mkRing=(h,amp=30)=>Array.from({length:36},(_,i)=>'rgb('+hsv2rgb(h+Math.sin(i/36*6.2832)*amp,.52,.72).join(',')+')');
const DEFCOL={c1:[58,84,176],c2:[96,70,170],c3:[8,12,30],ac:[176,194,255],ring:mkRing(225)};
const colorCache={};let fsLayer=1;
function rgb2hsv(r,g,b){r/=255;g/=255;b/=255;const mx=Math.max(r,g,b),mn=Math.min(r,g,b),d=mx-mn;let h=0;if(d){h=mx===r?((g-b)/d)%6:mx===g?(b-r)/d+2:(r-g)/d+4;h*=60;if(h<0)h+=360}return[h,mx?d/mx:0,mx]}
