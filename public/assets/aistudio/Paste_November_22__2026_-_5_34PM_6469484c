.spanel{position:relative;width:min(600px,100%);max-height:84vh;overflow:auto;border-radius:20px 20px 0 0;padding:20px 16px calc(18px + var(--safe));animation:up .25s ease;background:var(--s1);border:1px solid var(--line);scrollbar-width:thin}
